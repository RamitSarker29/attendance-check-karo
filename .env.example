# ============================================================================
# Attendance Check Karo - Supabase Environment Configuration
# ============================================================================
# Copy this file to '.env' and replace the placeholder values with your
# actual Supabase project credentials.
#
# Where to find these in Supabase:
# 1. Open your project on https://supabase.com/dashboard
# 2. Go to Project Settings (gear icon) -> API
# 3. Under "Project URL", copy the URL (e.g. https://xyzcompany.supabase.co)
# 4. Under "Project API keys", copy the 'anon' / 'public' key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
